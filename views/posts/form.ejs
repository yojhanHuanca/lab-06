<!DOCTYPE html><html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title><%= post && post._id ? 'Editar' : 'Crear' %> · Social Media</title><link rel="stylesheet" href="/css/style.css"><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@500;700;900&display=swap" rel="stylesheet"></head><body>
<%- include('../partials/header') %>
<main class="page-shell compose-layout"><aside class="compose-intro"><p class="eyebrow">ESTUDIO DE PUBLICACIÓN <span>✳</span></p><h1><%= post && post._id ? 'Dale una nueva forma a tu historia.' : 'Todo empieza con una idea.' %></h1><p><%= post && post._id ? 'Ajusta los detalles y vuelve a compartir tu perspectiva.' : 'Una frase, una imagen, un momento. Este espacio es tuyo.' %></p><div class="compose-note"><span>✳</span><p>Las mejores historias merecen un espacio donde respirar.</p></div></aside>
<section class="compose-panel"><div class="form-overline"><span><%= post && post._id ? 'EDITAR PUBLICACIÓN' : 'NUEVA PUBLICACIÓN' %></span><span>01 — 05</span></div><h2><%= post && post._id ? 'Editar historia' : 'Cuéntanos tu historia' %></h2>
<% if (error) { %><div class="form-error" role="alert"><strong>Revisa los datos:</strong> <%= error %></div><% } %>
<% if (!users.length) { %><div class="form-error">Necesitas un usuario para publicar. Crea uno antes de continuar.</div><% } %>
<form action="<%= action %><%= method === 'PUT' ? '?_method=PUT' : '' %>" method="POST"><% if (method === 'PUT') { %><input type="hidden" name="_method" value="PUT"><% } %>
<div class="field"><label for="title">01 <span>Título</span></label><input id="title" name="title" value="<%= post ? post.title : '' %>" minlength="5" maxlength="30" required placeholder="Una frase que invite a leer"><small>Entre 5 y 30 caracteres</small></div>
<div class="field"><label for="content">02 <span>Contenido</span></label><textarea id="content" name="content" minlength="10" required placeholder="Escribe lo que quieres compartir..."><%= post ? post.content : '' %></textarea><small>Al menos 10 caracteres</small></div>
<div class="field-row"><div class="field"><label for="user">03 <span>Autor</span></label><select id="user" name="user" required><option value="">Selecciona un usuario</option><% users.forEach(u => { %><option value="<%= u._id %>" <%= post && post.user && String(post.user._id || post.user) === String(u._id) ? 'selected' : '' %>><%= u.name %> <%= u.lastName %></option><% }) %></select></div><div class="field"><label for="hashtags">04 <span>Hashtags</span></label><input id="hashtags" name="hashtags" value="<%= post && post.hashtags ? (Array.isArray(post.hashtags) ? post.hashtags.join(', ') : post.hashtags) : '' %>" placeholder="arte, ideas, comunidad"><small>Separados por comas</small></div></div>
<div class="field"><label for="imageUrl">05 <span>Imagen (opcional)</span></label><input id="imageUrl" name="imageUrl" type="url" value="<%= post ? post.imageUrl || '' : '' %>" placeholder="https://ejemplo.com/imagen.jpg"></div>
<div class="form-actions"><button type="submit" class="btn btn-primary" <%= users.length ? '' : 'disabled' %>><%= post && post._id ? 'Guardar cambios' : 'Publicar historia' %> ↗</button><a href="/posts" class="btn btn-outline">Cancelar</a></div>
</form></section></main><%- include('../partials/footer') %></body></html>

