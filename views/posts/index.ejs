<!DOCTYPE html><html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Publicaciones · Social Media</title><link rel="stylesheet" href="/css/style.css"><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@500;700;900&display=swap" rel="stylesheet"></head><body>
<%- include('../partials/header') %>
<main class="page-shell">
    <section class="feed-heading"><div><p class="eyebrow">EL PULSO DE LA COMUNIDAD <span>✳</span></p><h1>Historias para<br><em>quedarse a leer.</em></h1><p class="lead">Ideas, momentos y perspectivas de quienes hacen esta comunidad.</p></div><div class="feed-aside"><span class="big-number"><%= posts.length.toString().padStart(2, '0') %></span><span>PUBLICACIONES<br>COMPARTIDAS</span><a href="/posts/new" class="btn btn-primary">Escribir una historia <span>↗</span></a></div></section>
    <% if (['created','updated','deleted'].includes(notice)) { %><div class="notice" role="status"><span>✓</span> <%= {created:'Publicación creada correctamente.',updated:'Cambios guardados correctamente.',deleted:'Publicación eliminada.'}[notice] %></div><% } %>
    <div class="section-line"><span>01 / EXPLORAR</span><span>Lo más reciente primero</span></div>
    <% if (posts.length) { %><section class="editorial-grid" aria-label="Listado de publicaciones"><% posts.forEach((post, index) => { %>
    <article class="story-card <%= index === 0 ? 'story-featured' : '' %>">
        <% if (post.imageUrl) { %><img class="story-image" src="<%= post.imageUrl %>" alt="Imagen de <%= post.title %>" loading="lazy"><% } else { %><div class="story-art" aria-hidden="true"><span>✳</span><small>SOCIAL / MEDIA</small></div><% } %>
        <div class="story-body"><div class="story-top"><span class="story-index">N.º <%= String(index + 1).padStart(2,'0') %></span><time datetime="<%= post.createdAt ? post.createdAt.toISOString() : '' %>"><%= post.createdAt ? post.createdAt.toLocaleDateString('es-PE', {day:'numeric',month:'short',year:'numeric'}) : '' %></time></div><h2><%= post.title %></h2><p class="story-content"><%= post.content %></p>
        <div class="story-tags"><% (post.hashtags || []).forEach(tag => { %><span>#<%= tag %></span><% }) %></div>
        <div class="story-footer"><div class="author"><span class="author-avatar"><%= post.user && post.user.name ? post.user.name.charAt(0).toUpperCase() : '?' %></span><span><small>ESCRITO POR</small><strong><%= post.user ? post.user.name + ' ' + post.user.lastName : 'Autor desconocido' %></strong></span></div><div class="story-actions"><a href="/posts/<%= post._id %>/edit" class="text-action">Editar ↗</a><button type="button" class="text-action delete-action" data-delete-url="/posts/<%= post._id %>?_method=DELETE" data-title="<%= post.title %>">Eliminar</button></div></div>
        </div></article><% }) %></section><% } else { %><div class="empty-state"><span>✳</span><h2>Aquí empieza la conversación.</h2><p>No hay publicaciones todavía. Comparte la primera historia.</p><a class="btn btn-primary" href="/posts/new">Crear publicación ↗</a></div><% } %>
</main>
<dialog id="delete-dialog" class="confirm-dialog"><form id="delete-form" method="POST"><p class="eyebrow">CONFIRMAR ACCIÓN</p><h2>¿Eliminar esta publicación?</h2><p id="delete-description"></p><div class="dialog-actions"><button type="button" class="btn btn-outline" id="cancel-delete">Cancelar</button><button type="submit" class="btn btn-danger">Sí, eliminar</button></div></form></dialog>
<%- include('../partials/footer') %></body></html>
